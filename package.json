{
  "name": "winpulse-studio",
  "version": "1.4.0",
  "description": "WinPulse Studio - Windows Productivity Metrics and Desktop Utilities",
  "author": "tatv",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.tatv.winpulse",
    "productName": "WinPulse Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinPulse Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [
    "productivity",
    "counter",
    "clipboard",
    "autoclicker"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse-fork": "^1.2.0",
    "pdf-to-img": "^7.0.1",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  }
}
